{
  "name": "Droid 4.4",
  "short_name": "Droid",
  "description": "Droid, a web imitation of Android 4.4 KitKat, by Danen",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.android.package-archive",
            "application/x-dpk",
            ".apk",
            ".dpk",
            "application/octet-stream",
            "application/zip",
            "*/*"
          ]
        }
      ]
    }
  }
}